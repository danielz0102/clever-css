{
  "name": "clever-css",
  "displayName": "Clever CSS",
  "version": "0.0.2",
  "description": "Augmented Intellisense for CSS files",
  "categories": [
    "Linters",
    "Programming Languages",
    "Visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielz0102/clever-css"
  },
  "publisher": "daniel-zambrano",
  "main": "./dist/extension.mjs",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vscode-test",
    "format": "oxfmt"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.44.1",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "25.9.2",
    "@types/parse5": "^7.0.0",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "configuration": {
      "title": "Clever CSS",
      "properties": {
        "clever-css.diagnostics": {
          "title": "Diagnostics",
          "description": "Enable or disable specific warnings",
          "type": "object",
          "default": {
            "unusedClasses": true,
            "duplicatedClasses": true
          },
          "additionalProperties": false,
          "properties": {
            "unusedClasses": {
              "title": "Unused Classes",
              "type": "boolean",
              "description": "Warnings for unused CSS classes"
            },
            "duplicatedClasses": {
              "title": "Duplicated Classes",
              "type": "boolean",
              "description": "Warnings for duplicated CSS classes"
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "cleverCss.rescan",
        "title": "Rescan Workspace",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cleverCss.rescan",
          "when": "view == classes",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cleverCss",
          "title": "Clever CSS",
          "icon": "$(symbol-color)"
        }
      ]
    },
    "views": {
      "cleverCss": [
        {
          "id": "classes",
          "name": "All Classes",
          "icon": ""
        },
        {
          "id": "unusedClasses",
          "name": "Unused Classes",
          "icon": ""
        },
        {
          "id": "duplicatedClasses",
          "name": "Duplicated Classes",
          "icon": ""
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "classes",
        "contents": "No CSS classes found in the workspace."
      },
      {
        "view": "unusedClasses",
        "contents": "No unused CSS classes found."
      },
      {
        "view": "duplicatedClasses",
        "contents": "No duplicated CSS classes found."
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.120.0"
  }
}
